# Copier en .env puis adapter. Sans .env, les valeurs de développement ci-dessous s'appliquent.

# Sécurité : en production, une longue chaîne aléatoire (ex. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-change-me
# Premier administrateur, créé au premier démarrage d'une base vide (mot de passe à changer en production).
# ADMIN_EMAIL peut être un simple identifiant de connexion (ex. admin) : ce compte ne reçoit alors aucun email.
ADMIN_EMAIL=admin@pilotage.local
ADMIN_PASSWORD=admin1234
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Tickson
# Comptes créés au démarrage s'ils n'existent pas, sans mot de passe : chacun reçoit un lien pour le choisir.
# INITIAL_USERS=[{"email": "prenom.nom@entreprise.fr", "first_name": "Prénom", "last_name": "Nom", "role": "project_manager"}]
# Validité des liens d'activation et de mot de passe oublié, en heures
PASSWORD_LINK_HOURS=72

# Base : fichier SQLite dans le volume Docker (à sauvegarder)
DATABASE_URL=sqlite:////data/pilotage.db

# Emails : Mailpit en développement (http://localhost:8025), votre relais SMTP en production
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pilotage@pilotage.local
# Sécurité de la connexion SMTP : none (Mailpit, relais interne), starttls (port 587) ou ssl (port 465)
SMTP_SECURITY=none
# Si renseignée, tous les emails partent vers cette adresse (recette)
SMTP_TEST_RECIPIENT=
# Adresse de l'application, utilisée dans les liens des emails
APP_BASE_URL=http://localhost:8080

# IA des comptes-rendus : « mock » (démonstration, sans IA), « anthropic » (service externe)
# ou « local » (Ollama ou vLLM dans votre infrastructure : `make ia-locale`)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LOCAL_LLM_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# Délai par appel, en secondes : 120 avec une API ; 600 ou plus pour un modèle local sans carte graphique
LLM_TIMEOUT_SECONDS=120

# Fichiers déposés : dossier du volume, suppression définitive N jours après la livraison, taille maximale
FILES_DIR=/data/files
FILES_PURGE_DAYS=30
MAX_UPLOAD_MB=10

# Cookie de session réservé à HTTPS : true dès que l'application est servie en https://
COOKIE_SECURE=false

# Paramètres métier
DUE_SOON_DAYS=7
OVERDUE_JOB_HOUR=8
DONE_HIDE_DAYS=30
